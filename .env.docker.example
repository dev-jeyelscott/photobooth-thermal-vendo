APP_NAME=ThermaSnap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=thermasnap
DB_USERNAME=thermasnap
DB_PASSWORD=thermasnap

POSTGRES_DB=thermasnap
POSTGRES_USER=thermasnap
POSTGRES_PASSWORD=thermasnap

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=public
IMAGE_DRIVER=gd

BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173
VITE_HMR_HOST=localhost
VITE_HMR_CLIENT_PORT=5173

MAYA_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=

PHOTOBOOTH_DEFAULT_PRINTER_DRIVER=local_mock
PHOTOBOOTH_PRINT_BRIDGE_ENDPOINT=
PHOTOBOOTH_PRINT_BRIDGE_TIMEOUT_SECONDS=10
PHOTOBOOTH_PRINT_BRIDGE_AUTH_TOKEN=
