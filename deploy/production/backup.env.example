# Install outside the release tree as /etc/photobooth/backup.env with mode 600.
# Use a PostgreSQL .pgpass file owned by the backup user instead of storing a
# database password here. See deploy/production/README.md.
BACKUP_DESTINATION=/var/backups/photobooth
MEDIA_SOURCE=/var/www/photobooth/storage/app/public
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=photobooth
DB_USERNAME=photobooth_backup
PGPASSFILE=/etc/photobooth/.pgpass
RETENTION_DAYS=14
