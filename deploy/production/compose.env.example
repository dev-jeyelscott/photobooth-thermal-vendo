# Install as /etc/photobooth/compose.env with mode 600.
# This file contains deployment/runtime controls, not Laravel secrets.

# Use one never-rebuilt release tag for both production images.
THERMASNAP_APP_IMAGE=thermasnap-app:REPLACE_WITH_GIT_SHA
THERMASNAP_NGINX_IMAGE=thermasnap-nginx:REPLACE_WITH_GIT_SHA

APP_UID=10001
APP_GID=10001

APP_ENV_FILE=/etc/photobooth/app.env
POSTGRES_ENV_FILE=/etc/photobooth/postgres.env
THERMASNAP_MEDIA_PATH=/srv/photobooth/media

POSTGRES_HOST_PORT=54320
NGINX_HOST_PORT=8081

# Keep DB_QUEUE_RETRY_AFTER in app.env safely greater than this value.
QUEUE_WORKER_TIMEOUT=60

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=1g

APP_CPUS=0.75
APP_MEMORY_LIMIT=768m

WORKER_CPUS=1.0
WORKER_MEMORY_LIMIT=1g

SCHEDULER_CPUS=0.25
SCHEDULER_MEMORY_LIMIT=256m

NGINX_CPUS=0.25
NGINX_MEMORY_LIMIT=128m
