# Install as /etc/photobooth/app.env with mode 600.
# Never commit the populated production file.

APP_NAME=ThermaSnap
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://photobooth.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=photobooth
DB_USERNAME=photobooth
DB_PASSWORD=

FILESYSTEM_DISK=public
IMAGE_DRIVER=gd

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAYA_BASE_URL=
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=

PHOTOBOOTH_DEFAULT_PRINTER_DRIVER=local_mock
PHOTOBOOTH_PRINT_BRIDGE_ENDPOINT=
PHOTOBOOTH_PRINT_BRIDGE_TIMEOUT_SECONDS=10
PHOTOBOOTH_PRINT_BRIDGE_AUTH_TOKEN=
