# Copy this file to /var/www/photobooth/.env on the production host, replace
# each placeholder through the host's secret manager, and set ownership to the
# PHP-FPM user with mode 640. Do not commit the populated file.
APP_NAME="Photobooth Thermal Vendo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://photobooth.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL is required in production. The database and queue tables are
# created by `php artisan migrate --force` during the release.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=photobooth
DB_USERNAME=photobooth
DB_PASSWORD=

# Gallery, template, sticker, generated GIF, and receipt assets explicitly use
# the named public disk. Keep the public disk mounted on persistent storage.
FILESYSTEM_DISK=public

# Print jobs implement ShouldQueue and require a worker.
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
SESSION_DRIVER=database

# Set production payment credentials in the host secret manager. Do not add
# them to this example or commit them to the repository.
MAYA_BASE_URL=
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=
