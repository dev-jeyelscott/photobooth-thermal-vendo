# Install as /etc/photobooth/postgres.env with mode 600.
# The bootstrap superuser is used only for PostgreSQL administration.

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# These values initialize the restricted Laravel application role and database.
# APP_DB_PASSWORD must match DB_PASSWORD in app.env.
APP_DB_NAME=photobooth
APP_DB_USER=photobooth
APP_DB_PASSWORD=

# This role is read-only and is used by the host backup job.
BACKUP_DB_USER=photobooth_backup
BACKUP_DB_PASSWORD=
