; Install as /etc/supervisor/conf.d/photobooth-worker.conf after replacing
; __APP_ROOT__ and __APP_USER__.
[program:photobooth-worker]
process_name=%(program_name)s_%(process_num)02d
command=/usr/bin/php __APP_ROOT__/artisan queue:work database --queue=default --sleep=3 --tries=3 --max-time=3600
directory=__APP_ROOT__
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=__APP_USER__
numprocs=1
redirect_stderr=true
stdout_logfile=__APP_ROOT__/storage/logs/queue-worker.log
stopwaitsecs=3600
